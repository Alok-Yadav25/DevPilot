# Never commit .env. Copy this file and fill values locally.
GROQ_API_KEY=
# Consult https://console.groq.com/docs/models for currently supported models.
# Every live run also verifies this ID against the authenticated /models endpoint.
GROQ_MODEL=openai/gpt-oss-120b
# Deprecated: not used for sandbox or target publication.
GITHUB_TOKEN=
SANDBOX_IMAGE=devpilot-sandbox:py311
TEST_TIMEOUT_SECONDS=120
RUN_TIMEOUT_SECONDS=900
MAX_ATTEMPTS=3
WORK_ROOT=.devpilot/workspaces
ARTIFACT_ROOT=.devpilot/runs

# PostgreSQL: use a pooled Neon/Supabase connection string for remote databases.
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@127.0.0.1:5432/devpilot
# Run migrations in production. Auto-create is for explicit local development only.
DATABASE_AUTO_CREATE=false
# Required for all run/evaluation/decision endpoints. Generate a strong random value.
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CONCURRENT_RUNS=1
REQUESTS_PER_MINUTE=30

# Website, worker and CLI: public, allowlisted repos only.
RUNNER_MODE=github_actions
SANDBOX_REPO=
SANDBOX_DEFAULT_BRANCH=main
SANDBOX_GITHUB_TOKEN=
# Used only for human-approved target branch and draft PR publication.
TARGET_GITHUB_TOKEN=
ALLOWED_TARGET_REPOS=
MAX_REPO_MB=50
ACTIONS_TIMEOUT_SECONDS=900
# ALLOWED_ORIGINS is accepted as an alias of CORS_ORIGINS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_ENV=production
MAX_QUEUED_RUNS=20
ALLOWED_TARGET_OWNER=
RETENTION_SECONDS=86400
