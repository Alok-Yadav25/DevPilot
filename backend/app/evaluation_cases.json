[
  {
    "id": "case-01",
    "name": "Normalize word separators",
    "category": "String handling",
    "bug_description": "Use hyphens between normalized words, never underscores.",
    "bug": "\"_\".join(value.strip().lower().split())",
    "fix": "\"-\".join(value.strip().lower().split())",
    "tests": [
      [
        "Hello World",
        "hello-world"
      ],
      [
        " a   b ",
        "a-b"
      ],
      [
        "",
        ""
      ]
    ]
  },
